source /container/base/functions/container/init
prepare_service 20-arr,40-sonarr
SERVICE_NAME="sonarr"

source /container/state/arr/mode

if var_false "${ENABLE_SONARR}" ; then
    print_debug "[sonarr] Disabled via ENABLE_SONARR"
    service_stop $(basename $0)
    liftoff
    exit 0
fi

if check_container_restarted ; then
    call sonarr_bootstrap_filesystems

    if [ "${SONARR_SETUP_TYPE,,}" = "auto" ] ; then
        call sonarr_configure_application
    else
        print_notice "[sonarr] Skipping config generation as SONARR_SETUP_TYPE='${SONARR_SETUP_TYPE}'"
    fi
fi

liftoff
