## General
PROWLARR_USER=${PROWLARR_USER:-"prowlarr"}
PROWLARR_GROUP=${PROWLARR_GROUP:-"arr"}
PROWLARR_SETUP_TYPE=${PROWLARR_SETUP_TYPE:-"${SETUP_TYPE}"}

## Paths
PROWLARR_CONFIG_PATH=${PROWLARR_CONFIG_PATH:-"${CONFIG_PATH%/}/prowlarr/"}

## Instance
PROWLARR_INSTANCE_NAME=${PROWLARR_INSTANCE_NAME:-"Prowlarr"}
PROWLARR_ENABLE_LAUNCH_BROWSER=${PROWLARR_ENABLE_LAUNCH_BROWSER:-"FALSE"}

## Authentication
PROWLARR_API_KEY=${PROWLARR_API_KEY:-""}
PROWLARR_AUTH_METHOD=${PROWLARR_AUTH_METHOD:-"None"}
PROWLARR_AUTH_REQUIRED=${PROWLARR_AUTH_REQUIRED:-"DisabledForLocalAddresses"}

## Logging
PROWLARR_LOG_FILE=${PROWLARR_LOG_FILE:-"prowlarr.log"}
PROWLARR_LOG_LEVEL=${PROWLARR_LOG_LEVEL:-"info"}
PROWLARR_LOG_PATH=${PROWLARR_LOG_PATH:-"${PROWLARR_CONFIG_PATH%/}/logs/"}
PROWLARR_LOG_TYPE=${PROWLARR_LOG_TYPE:-"${LOG_TYPE}"}

## Network
PROWLARR_LISTEN_IP=${PROWLARR_LISTEN_IP:-"*"}
PROWLARR_LISTEN_PORT=${PROWLARR_LISTEN_PORT:-"9696"}
PROWLARR_ENABLE_SSL=${PROWLARR_ENABLE_SSL:-"FALSE"}
PROWLARR_LISTEN_SSL_PORT=${PROWLARR_LISTEN_SSL_PORT:-"9697"}
PROWLARR_URL_BASE=${PROWLARR_URL_BASE:-""}

## Update
PROWLARR_UPDATE_MECHANISM=${PROWLARR_UPDATE_MECHANISM:-"Docker"}
PROWLARR_UPDATE_AUTOMATICALLY=${PROWLARR_UPDATE_AUTOMATICALLY:-"FALSE"}
PROWLARR_UPDATE_BRANCH=${PROWLARR_UPDATE_BRANCH:-"develop"}

