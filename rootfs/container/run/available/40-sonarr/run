source /container/base/functions/container/init
SERVICE_NAME="sonarr"
prepare_service 20-arr
prepare_service 40-sonarr

check_container_initialized
check_service_initialized init

liftoff

print_start "Starting Sonarr $(grep -o "ADD: Sonarr v.* |" /container/build/${IMAGE_NAME/\//_}/build.log | awk '{print $3}')"
case "${SONARR_LOG_TYPE,,}" in
    file)
        exec 1>>"${SONARR_LOG_PATH%/}/${SONARR_LOG_FILE}" 2>&1
        ;;
    both)
        exec 1> >(tee -a "${SONARR_LOG_PATH%/}/${SONARR_LOG_FILE}") 2>&1
        ;;
esac

cd /opt/sonarr

sudo -u "${SONARR_USER}" \
    /opt/sonarr/Sonarr \
        -nobrowser \
        -data="${SONARR_CONFIG_PATH}"